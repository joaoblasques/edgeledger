# Copy to .env and fill in. Never commit .env.

# Kalshi — required only for order book access (KALSHI-ACCESS-* headers, RSA-PSS signed)
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=   # path to local .pem, never the key material itself

# Polymarket — read APIs are unauthenticated, no key needed

# Local paths
EDGELEDGER_DATA_DIR=./data
