# Copy to .env and fill in. Never commit .env.

# Kalshi — required only for order book access (KALSHI-ACCESS-* headers, RSA-PSS signed)
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=   # path to local .pem, never the key material itself

# Polymarket — read APIs are unauthenticated, no key needed

# Bronze archive (Backblaze B2, S3-compatible). Optional: without these the pipeline
# still runs and still writes forecasts — it just discards raw order books instead of
# keeping them. See docs/setup-scheduling.md.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=edgeledger-bronze
B2_ENDPOINT=          # bare host, e.g. s3.eu-central-003.backblazeb2.com

# Local paths
EDGELEDGER_DATA_DIR=./data
